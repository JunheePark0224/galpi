# Supabase (web/.env.local 에 값을 넣는다 — 이 파일은 빈 칸으로 둔다)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# TRACK_STORE=off  # set to keep local runs out of the real events table
# 도감 v1: 뽑기 그림 seed에 서명하는 비밀값 — 서버에서만 읽는다. 32자 이상 무작위. Production에 없으면 도감 기록이 꺼진다 (사이트는 그대로)
COLLECTION_SIGNING_SECRET=
# P5 로그인 (Supabase Auth) — 공개 값이지만 대화에 붙이지 않는다. 비워 두면 로그인 자리가 숨는다. 빌드 때 박힌다
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 처리방침에 보이는 문의 이메일 (빌드 때 들어가므로 Vercel에 넣고 다시 배포)
NEXT_PUBLIC_CONTACT_EMAIL=
# Amplitude 공개 수집용 키 — Vercel Production에만 넣는다 (로컬·Preview는 비워 두면 Amplitude가 꺼진다). 빌드 때 박힌다
NEXT_PUBLIC_AMPLITUDE_API_KEY=
# 예스24 Open API (S-06 책 정보) — 서버에서만 읽는다. 없으면 카카오로, 둘 다 없으면 책 정보 없이 화면만
YES24_API_KEY=
# 카카오 책 검색 REST 키 — 예스24가 실패할 때 표지·가격만 대신 (PRD F-14)
KAKAO_REST_KEY=
# ANTHROPIC_API_KEY: daily pipeline only (GitHub Actions secret / root .env), not the site
# 갈피 우체통 도착 알림 메일 (Resend) — 서버에서만 읽는다. 둘 중 하나라도 비우면 알림을 보내지 않는다 (글은 그대로 저장). 메일에는 도착 시각만
RESEND_API_KEY=
# 알림을 받을 운영자 메일 주소
FEEDBACK_NOTIFY_TO=

# Public address for link preview cards (set when the domain is connected; empty = galpi-omega.vercel.app)
NEXT_PUBLIC_SITE_URL=
